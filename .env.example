# Set ONE of these (whichever company your credits are from)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Google AI Studio / Gemini (free tier, OpenAI-compatible) - tested:
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_API_KEY=your-ai-studio-key
# OPENAI_MODEL=gemini-3.5-flash
# OPENAI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.1-flash-lite
# OPENAI_REASONING_EFFORT=low

# Featherless (free hackathon credits, OpenAI-compatible):
# OPENAI_BASE_URL=https://api.featherless.ai/v1
# OPENAI_API_KEY=your-featherless-key
# OPENAI_MODEL=Qwen/Qwen2.5-72B-Instruct

# Run the agent on your own laptop with llama.cpp (OpenAI-compatible server):
#   llama-server -m your-model.gguf --port 8080 --jinja
# then set:
# OPENAI_BASE_URL=http://localhost:8080/v1

# Optional model overrides
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-5

# ElevenLabs voice ("Listen to this explanation")
ELEVENLABS_API_KEY=
# Optional: a specific voice. If empty, the first voice in your account is used.
# ELEVENLABS_VOICE_ID=

# DeepL translation of the explanation (free plan keys end with :fx)
# DEEPL_API_KEY=
# Without it, the connected AI translates instead.

# Speed: the default "fast" mode finds research with code and asks the AI to write once.
# AGENT_MODE=agent  # slower: the AI decides its own PubMed searches with tool calls

# Optional spending limits (explanations per hour)
# EXPLAIN_LIMIT_PER_PERSON=15
# EXPLAIN_LIMIT_TOTAL=150
