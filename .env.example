# Set ONE of these (whichever company your credits are from)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Featherless (free hackathon credits, OpenAI-compatible):
# OPENAI_BASE_URL=https://api.featherless.ai/v1
# OPENAI_API_KEY=your-featherless-key
# OPENAI_MODEL=Qwen/Qwen2.5-72B-Instruct

# Run the agent on your own laptop with llama.cpp (OpenAI-compatible server):
#   llama-server -m your-model.gguf --port 8080 --jinja
# then set:
# OPENAI_BASE_URL=http://localhost:8080/v1

# Optional model overrides
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-5

# ElevenLabs voice ("Listen to this explanation")
ELEVENLABS_API_KEY=
# Optional: a specific voice. If empty, the first voice in your account is used.
# ELEVENLABS_VOICE_ID=

# Optional spending limits (explanations per hour)
# EXPLAIN_LIMIT_PER_PERSON=15
# EXPLAIN_LIMIT_TOTAL=150
